{
  "name": "@xmwengxing/dsh-client-ui-sidebar-perfmon",
  "version": "0.1.0",
  "description": "Real-time host performance monitor for the DeepSeek Harness right Sidebar: CPU / memory / swap gauges plus a sortable process table. · DSH 右侧栏实时性能监控：CPU / 内存 / 交换内存 仪表盘与可排序进程列表。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sidebar",
    "monitor",
    "performance",
    "perfmon",
    "cpu",
    "memory",
    "process"
  ],
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "prepare": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node scripts/build-test-bundle.mjs && node --test \"test/*.test.mjs\"",
    "test:unit": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmwengxing/dsh-client-ui-sidebar-perfmon.git"
  },
  "bugs": {
    "url": "https://github.com/xmwengxing/dsh-client-ui-sidebar-perfmon/issues"
  },
  "homepage": "https://github.com/xmwengxing/dsh-client-ui-sidebar-perfmon#readme"
}
